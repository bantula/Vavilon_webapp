# ── Core ──────────────────────────────────────────────────────────────────────
PORT=3000
AI_SERVICE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ── Redis (Azure Cache for Redis) ─────────────────────────────────────────────
# Hostname WITHOUT protocol or port (TLS on 6380 is applied automatically).
# Leave REDIS_URL empty to use a local redis://localhost:6379.
REDIS_URL=your-cache.redis.cache.windows.net
REDIS_PASSWORD=your-redis-access-key

# ── Azure Blob Storage (lead persistence) ─────────────────────────────────────
# Full connection string from the storage account. If unset, /api/leads is
# disabled but the rest of the backend still runs.
AZURE_STORAGE_CONNECTION_STRING=

# ── Admin API auth ────────────────────────────────────────────────────────────
# Sent by clients as the X-Admin-Key header. ADMIN_SECRET and ADMIN_KEY are
# interchangeable — set one value.
ADMIN_SECRET=your-admin-secret

# ── Observability (optional) ──────────────────────────────────────────────────
APPINSIGHTS_INSTRUMENTATIONKEY=
