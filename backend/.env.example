# ── Core ──────────────────────────────────────────────────────────────────────
PORT=3000
AI_SERVICE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# ── Azure Blob Storage (guides + leads) ───────────────────────────────────────
# Full connection string from the storage account. Guide accounts are loaded
# from the `guides` container (guides.json) at startup; leads are appended to the
# `leads` container. For local dev without this, guides fall back to
# backend/data/guides.json and /api/leads is disabled — the rest still runs.
AZURE_STORAGE_CONNECTION_STRING=

# ── Admin API auth ────────────────────────────────────────────────────────────
# Sent by clients as the X-Admin-Key header. ADMIN_SECRET and ADMIN_KEY are
# interchangeable — set one value.
ADMIN_SECRET=your-admin-secret

# ── Observability (optional) ──────────────────────────────────────────────────
APPINSIGHTS_INSTRUMENTATIONKEY=
